#intro>.io-lang{position:absolute;top:18px;right:18px;display:flex;gap:6px}.io-lang button{background:rgba(0,0,0,.5);border:1px solid rgba(212,175,55,.5);color:var(--gold2);font:700 12px inherit;font-family:inherit;padding:7px 13px;border-radius:999px;cursor:pointer}.io-lang button:hover{background:rgba(212,175,55,.2)}
