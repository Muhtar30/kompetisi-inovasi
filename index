.lang li.hd{font-size:11px;color:var(--gold2);cursor:default;letter-spacing:1px;border-bottom:1px solid var(--bd)}.lang li.hd:hover{background:none}
.lang>button{white-space:nowrap;font-size:11.5px}
.sc{text-align:center}.sc .mm{color:var(--m);font-weight:600;margin-top:8px}.sc .aa{font-size:clamp(18px,2.2vw,26px);font-weight:900;margin-top:4px}.sc .ar{display:block;margin:4px 0}
