/* ===== SINEMA: intro, tombol play, mode tayang ===== */
@keyframes fadeInDown{from{opacity:0;transform:translateY(-34px)}to{opacity:1;transform:none}}
@keyframes fadeInUp{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
@keyframes zoomInFade{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
@keyframes pulseGlow{0%,100%{opacity:.4;transform:scale(1)}50%{opacity:1;transform:scale(1.14)}}
@keyframes dustUp{0%{transform:translate(0,0);opacity:0}15%{opacity:.9}100%{transform:translate(var(--dx,20px),-108vh);opacity:0}}
@keyframes goldShine{to{background-position:200% center}}
@keyframes blinkC{50%{opacity:0}}@keyframes typeIn{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
